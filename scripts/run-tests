#!/bin/sh
set -eu

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
FEATURE="${1:-}"
if [ -n "$FEATURE" ]; then shift; fi
# $@ now contains zero or more scenario names

line="===================================="
run_scenarios() {
    _feature="$1"
    shift
    if [ $# -eq 0 ]; then
        printf '%s %s | scenarios %s\n' $line "$_feature" $line
        devcontainer features test \
            --project-folder . \
            --features "$_feature" \
            --skip-autogenerated \
            --log-level info
    else
        for _scenario in "$@"; do
            printf '%s %s | %s %s\n' $line "$_feature" "$_scenario" $line
            devcontainer features test \
                --project-folder . \
                --features "$_feature" \
                --filter "$_scenario" \
                --skip-autogenerated \
                --log-level info
        done
    fi
}

if [ -z "$FEATURE" ]; then
    for _feature in "$SCRIPT_DIR/../src"/*/; do
        run_scenarios "$(basename "$_feature")"
    done
else
    run_scenarios "$FEATURE" "$@"
fi
